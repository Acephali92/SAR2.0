{
  "name": "sar2-cms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Redaktionsbereich (Payload CMS 3 + PostgreSQL) fuer stoppramstein.de. Eigenstaendiges npm-Projekt, bewusst kein Workspace mit dem Astro-Root.",
  "scripts": {
