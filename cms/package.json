    "graphql": "^16.9.0",
    "next": "^15.1.0",
    "payload": "^3.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "gray-matter": "^4.0.3",
    "ts-node": "^10.9.2",
    "turndown": "^7.2.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=22.0.0"
