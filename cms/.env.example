# Datenbank (Postgres-Container aus docker-compose.yml)
DATABASE_URI=postgres://payload:CHANGEME@postgres:5432/payload

# Payload-Secret zum Signieren von Sessions/Tokens - langer Zufallsstring, z.B. `openssl rand -base64 48`
PAYLOAD_SECRET=CHANGEME_long_random_string

# Oeffentliche URL der Redaktionsoberflaeche
PAYLOAD_PUBLIC_SERVER_URL=https://redaktion.stoppramstein.de
NEXT_PUBLIC_SERVER_URL=https://redaktion.stoppramstein.de

# Ablageort fuer Uploads (im Container, per Volume auf den Host gemappt)
UPLOAD_DIR=/data/uploads

# SMTP fuer Passwort-Reset-E-Mails (M1) und Rebuild-Fehlerbenachrichtigungen (M9)
SMTP_HOST=CHANGEME
SMTP_PORT=587
SMTP_USER=CHANGEME
SMTP_PASS=CHANGEME
SMTP_FROM="Stopp Air Base Ramstein <redaktion@stoppramstein.de>"
REDAKTION_NOTIFY_EMAIL=redaktion@stoppramstein.de

# Rebuild-Webhook (M9) - shared secret zwischen Payload und rebuild-webhook-Dienst
REBUILD_WEBHOOK_URL=http://rebuild-webhook:8090/rebuild
REBUILD_WEBHOOK_SECRET=CHANGEME_shared_secret

# API-Token, mit dem der Astro-Build (Content-Layer-Loader) lesend auf veroeffentlichte
# Beitraege/Termine zugreift. Wird als "API Key" eines dedizierten Service-Users in Payload angelegt.
PAYLOAD_API_TOKEN=CHANGEME_service_user_api_key

# Optional (M10): Offsite-Kopie der naechtlichen Backups per rclone, zusaetzlich zur lokalen
# 14-Tage-Aufbewahrung. Leer lassen = nur lokales Backup (Default, kein Verhaltensunterschied).
# Format: <rclone-remote-name>:<pfad>, z.B. "eu-storage:stoppramstein-backups". Setzt voraus,
# dass secrets/rclone.conf existiert (siehe docs/DEPLOYMENT.md, "Backups & Wiederherstellung").
OFFSITE_RCLONE_REMOTE=
