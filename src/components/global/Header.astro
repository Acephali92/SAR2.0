---
/**
 * @component Header
 * @description Refined navbar with semi-transparent background, centered pill navigation,
 *              and strong brand integration (red accents for urgency, cyan-blue for CTA).
 */

// Navigation items - centralized for consistency
const navItems = [
  { href: '/warum-ramstein/', label: 'Warum' },
  { href: '/fakten/', label: 'Fakten' },
  { href: '/analysen/', label: 'Analysen' },
  { href: '/aktionen/', label: 'Aktionen' },
  { href: '/mitmachen/', label: 'Mitmachen' },
  { href: '/ueber-uns/', label: 'Über uns' },
];

const currentPath = Astro.url.pathname;
---

<header
  id="site-header"
  class="fixed top-0 z-50 w-full bg-white/80 backdrop-blur-md transition-all duration-300"
>
  <div class="mx-auto max-w-7xl px-4 md:px-6">
    <nav class="flex h-20 items-center justify-between" aria-label="Hauptnavigation">
      <!-- Logo (enlarged 1.2-1.5x) -->
      <a
        href="/"
        class="relative z-10 flex shrink-0 items-center no-underline transition-transform hover:scale-105"
      >
        <img
          src="/images/Logo_Header.png"
          alt="Stopp Air Base Ramstein"
          class="h-14 w-auto md:h-16 lg:h-[4.5rem]"
        />
      </a>

      <!-- Desktop Navigation: Centered Pill Style -->
      <div class="absolute left-1/2 hidden -translate-x-1/2 lg:block">
        <ul
          class="nav-pill flex items-center rounded-full bg-white/90 px-3 py-2 shadow-md backdrop-blur-sm"
          role="list"
        >
          {
            navItems.map((item, index) => {
              const isActive = currentPath.startsWith(item.href);
              return (
                <li class="flex items-center">
                  <a
                    href={item.href}
                    class:list={[
                      'nav-link px-4 py-1.5 text-sm font-bold no-underline transition-all duration-200',
                      isActive
                        ? 'text-brand-red'
                        : 'text-slate-800 hover:text-brand-red',
                    ]}
                    aria-current={isActive ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                  {index < navItems.length - 1 && (
                    <span class="text-slate-200" aria-hidden="true">|</span>
                  )}
                </li>
              );
            })
          }
        </ul>
      </div>

      <!-- CTA Button (Desktop): Red pill with pulse hover -->
      <div class="relative z-10 hidden lg:block">
        <a
          href="/mitmachen/spenden/"
          class="spenden-btn inline-flex items-center gap-2 rounded-full bg-brand-red px-7 py-3 text-sm font-bold text-white no-underline shadow-lg transition-all duration-200 hover:bg-brand-red-hover hover:shadow-xl hover:scale-105"
        >
          Spenden
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        class="relative z-10 inline-flex items-center justify-center rounded-full bg-white p-2.5 text-slate-900 shadow-md transition-all hover:shadow-lg lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="mobile-menu-button"
      >
        <span class="sr-only">Menü öffnen</span>
        <svg
          class="hamburger-icon h-6 w-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
        <svg
          class="close-icon hidden h-6 w-6"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M6 18L18 6M6 6l12 12"
          />
        </svg>
      </button>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-slate-100 bg-white/95 backdrop-blur-md lg:hidden"
    aria-labelledby="mobile-menu-button"
  >
    <div class="mx-auto max-w-7xl px-4 py-6">
      <ul class="space-y-1" role="list">
        {
          navItems.map((item) => {
            const isActive = currentPath.startsWith(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'block px-4 py-3 text-lg font-bold no-underline rounded-xl transition-all',
                    isActive
                      ? 'text-brand-red bg-red-50'
                      : 'text-slate-900 hover:text-brand-red hover:bg-red-50/50',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            );
          })
        }
        <li class="pt-4">
          <a
            href="/mitmachen/spenden/"
            class="block rounded-full bg-brand-red px-4 py-3.5 text-center text-lg font-bold text-white no-underline transition-all hover:bg-brand-red-hover"
          >
            Spenden
          </a>
        </li>
      </ul>
    </div>
  </div>
</header>

<!-- Spacer for fixed header (hidden when hero-overlap class is on wrapper) -->
<div class="header-spacer h-20" aria-hidden="true"></div>

<style>
  /* Header scroll state - slightly more opaque when scrolled */
  #site-header.scrolled {
    @apply bg-white/95 shadow-md;
  }

  /* Nav pill subtle hover lift */
  .nav-pill {
    transition: box-shadow 0.3s ease, transform 0.3s ease;
  }

  .nav-pill:hover {
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.1);
  }

  /* Nav link hover underline effect */
  .nav-link {
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: rgb(var(--color-brand-red));
    transition: width 0.2s ease, left 0.2s ease;
  }

  .nav-link:hover::after {
    width: 60%;
    left: 20%;
  }

  /* Spenden button subtle pulse on hover */
  .spenden-btn:hover {
    animation: subtle-pulse 1.5s ease-in-out infinite;
  }

  @keyframes subtle-pulse {
    0%, 100% {
      box-shadow: 0 10px 25px -5px rgb(var(--color-brand-red) / 0.4);
    }
    50% {
      box-shadow: 0 10px 30px -5px rgb(var(--color-brand-red) / 0.6);
    }
  }
</style>

<script type="module" src="/scripts/header.js"></script>
