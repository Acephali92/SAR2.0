---
/**
 * @component Footer
 * @description Site footer with links, contact, and legal information.
 */

const currentYear = new Date().getFullYear();

const footerLinks = {
  kampagne: [
    { href: '/warum-ramstein/', label: 'Warum Ramstein' },
    { href: '/fakten/', label: 'Fakten' },
    { href: '/analysen/', label: 'Analysen' },
    { href: '/aktionen/', label: 'Aktionen' },
  ],
  mitmachen: [
    { href: '/mitmachen/spenden/', label: 'Spenden' },
    { href: '/mitmachen/mitglied-werden/', label: 'Mitglied werden' },
    { href: '/mitmachen/ehrenamt/', label: 'Ehrenamtlich helfen' },
    { href: '/mitmachen/aufruf/', label: 'Aufruf unterzeichnen' },
  ],
  info: [
    { href: '/ueber-uns/', label: 'Über uns' },
    { href: '/presse/', label: 'Presse' },
    { href: '/kontakt/', label: 'Kontakt' },
    { href: '/impressum/', label: 'Impressum' },
  ],
};

const contactEmail = 'info@stoppramstein.de';
---

<footer class="mt-auto border-t border-slate-200 bg-slate-50">
  <div class="container mx-auto px-4 py-12 md:px-6 lg:py-16">
    <!-- Footer Grid -->
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
      <!-- About Column -->
      <div class="lg:col-span-1">
        <h2 class="mb-4 text-lg font-semibold text-slate-900">
          Stopp Air Base Ramstein
        </h2>
        <p class="mb-4 text-sm text-slate-600">
          Kampagne für die Schließung der US Air Base Ramstein — für Frieden,
          Völkerrecht und Umweltschutz.
        </p>
        <a
          href={`mailto:${contactEmail}`}
          class="text-sm text-sky-600 hover:text-slate-900"
        >
          {contactEmail}
        </a>
      </div>

      <!-- Kampagne Links -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-slate-500">
          Kampagne
        </h3>
        <ul class="space-y-2" role="list">
          {
            footerLinks.kampagne.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-slate-600 no-underline transition-colors hover:text-slate-900"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Mitmachen Links -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-slate-500">
          Mitmachen
        </h3>
        <ul class="space-y-2" role="list">
          {
            footerLinks.mitmachen.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-slate-600 no-underline transition-colors hover:text-slate-900"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Info Links -->
      <div>
        <h3 class="mb-4 text-sm font-semibold uppercase tracking-wider text-slate-500">
          Information
        </h3>
        <ul class="space-y-2" role="list">
          {
            footerLinks.info.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-sm text-slate-600 no-underline transition-colors hover:text-slate-900"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-slate-200 pt-8 md:flex-row">
      <p class="text-sm text-slate-500">
        &copy; {currentYear} Stopp Air Base Ramstein e.V. — Alle Rechte vorbehalten.
      </p>
      <p class="text-sm text-slate-500">
        <a
          href="/datenschutz/"
          class="no-underline hover:text-slate-700"
        >
          Datenschutz
        </a>
        <span class="mx-2">·</span>
        <a href="/impressum/" class="no-underline hover:text-slate-700">
          Impressum
        </a>
      </p>
    </div>
  </div>
</footer>
