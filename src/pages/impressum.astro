---
/**
 * Impressum page
 */

import { getEntry, render } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';

const entry = await getEntry('seiten', 'impressum');
if (!entry) throw new Error('Impressum page not found');

const { Content } = await render(entry);
---

<PageLayout title={entry.data.title} description={entry.data.description}>
  <article class="mx-auto max-w-2xl">
    <h1 class="mb-8 text-3xl font-bold">{entry.data.title}</h1>
    <div class="prose-custom font-serif">
      <Content />
    </div>
  </article>
</PageLayout>

<style>
  .prose-custom :global(h2) {
    @apply mt-8 mb-4 text-xl font-semibold font-sans;
  }

  .prose-custom :global(p) {
    @apply mb-4 text-content-secondary;
  }

  .prose-custom :global(a) {
    @apply text-accent-sky hover:text-content-primary;
  }
</style>
