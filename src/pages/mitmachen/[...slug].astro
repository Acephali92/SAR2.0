---
/**
 * Dynamic route for mitmachen content pages
 * Uses MitmachenLayout for proper visual hierarchy and CTAs
 */

import { getCollection, render, type CollectionEntry } from 'astro:content';
import MitmachenLayout from '@layouts/MitmachenLayout.astro';

export async function getStaticPaths() {
  // Einträge mit eigener Seite in diesem Ordner (mitglied-werden.astro) hier auslassen.
  // Steht innerhalb der Funktion, weil getStaticPaths keinen Zugriff auf den übrigen Frontmatter hat.
  const OWN_ROUTES = new Set(['mitglied-werden']);
  const entries = await getCollection('mitmachen', (entry) => !OWN_ROUTES.has(entry.id));
  return entries.map((entry: CollectionEntry<'mitmachen'>) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'mitmachen'>;
}

const { entry } = Astro.props as Props;
const { Content } = await render(entry);
---

<MitmachenLayout
  title={entry.data.title}
  description={entry.data.description}
  ctaType={entry.data.ctaType}
  contactEmail={entry.data.contactEmail}
>
  <Content />
</MitmachenLayout>
