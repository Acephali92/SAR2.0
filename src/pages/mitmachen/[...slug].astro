---
/**
 * Dynamic route for mitmachen content pages
 * Uses MitmachenLayout for proper visual hierarchy and CTAs
 */

import { getCollection, render, type CollectionEntry } from 'astro:content';
import MitmachenLayout from '@layouts/MitmachenLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('mitmachen');
  return entries.map((entry: CollectionEntry<'mitmachen'>) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'mitmachen'>;
}

const { entry } = Astro.props as Props;
const { Content } = await render(entry);
---

<MitmachenLayout
  title={entry.data.title}
  description={entry.data.description}
  ctaType={entry.data.ctaType}
  contactEmail={entry.data.contactEmail}
>
  <Content />
</MitmachenLayout>
