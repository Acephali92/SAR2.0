---
/**
 * @page MitmachenIndex
 * @description Hub page for all engagement options in the mitmachen section.
 *              Displays engagement cards, impact stats, and quick action buttons.
 *
 * @accessibility
 * - All sections have appropriate aria-labels
 * - Cards are focusable with visible focus states
 * - Images have empty alt text (decorative)
 * - Proper heading hierarchy maintained
 */

import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Header from '@components/global/Header.astro';
import Footer from '@components/global/Footer.astro';
import Button from '@components/ui/Button.astro';

// ---------------------------------------------------------------------------
// Data Fetching
// ---------------------------------------------------------------------------

const entries = await getCollection('mitmachen');
const sortedEntries = entries.sort(
  (a: CollectionEntry<'mitmachen'>, b: CollectionEntry<'mitmachen'>) =>
    a.data.order - b.data.order
);

// ---------------------------------------------------------------------------
// Configuration
// ---------------------------------------------------------------------------

/**
 * CTA configuration per engagement type.
 * Defines labels, colors, and styling for each card type.
 */
const ctaConfig: Record<string, {
  label: string;
  badge: string;
  icon: keyof typeof icons;
  color: string;
  bgColor: string;
  borderColor: string;
  hoverBg: string;
}> = {
  petition: {
    label: 'Jetzt unterschreiben',
    badge: 'Petition',
    icon: 'pencil',
    color: 'text-amber-600',
    bgColor: 'bg-amber-50',
    borderColor: 'border-amber-200',
    hoverBg: 'group-hover:bg-amber-100',
  },
  spenden: {
    label: 'Jetzt spenden',
    badge: 'Finanziell',
    icon: 'heart',
    color: 'text-rose-600',
    bgColor: 'bg-rose-50',
    borderColor: 'border-rose-200',
    hoverBg: 'group-hover:bg-rose-100',
  },
  mitgliedschaft: {
    label: 'Mitglied werden',
    badge: 'Mitgliedschaft',
    icon: 'users',
    color: 'text-sky-600',
    bgColor: 'bg-sky-50',
    borderColor: 'border-sky-200',
    hoverBg: 'group-hover:bg-sky-100',
  },
  ehrenamt: {
    label: 'Aktiv werden',
    badge: 'Ehrenamt',
    icon: 'hand',
    color: 'text-emerald-600',
    bgColor: 'bg-emerald-50',
    borderColor: 'border-emerald-200',
    hoverBg: 'group-hover:bg-emerald-100',
  },
};

/**
 * Card images per engagement type.
 */
const ctaImages: Record<string, string> = {
  spenden: '/images/unterstuetze-uns-mit-einer-spende.jpg',
  mitgliedschaft: '/images/werde-mitglied-im-foerderverein.jpg',
  ehrenamt: '/images/hilf-uns-bei-der-organisation.jpg',
  petition: '/images/aufruf-unterzeichnen.jpg',
};

// ---------------------------------------------------------------------------
// Icons (SVG paths for inline rendering)
// ---------------------------------------------------------------------------

const icons = {
  pencil: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />`,
  heart: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />`,
  users: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />`,
  hand: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11m0-5.5a1.5 1.5 0 013 0v3m0 0V11" />`,
  arrow: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />`,
  mail: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`,
} as const;
---

<BaseLayout
  title="Mitmachen"
  description="Unterstützen Sie die Kampagne Stopp Air Base Ramstein. Spenden, Mitglied werden, ehrenamtlich helfen oder den Aufruf unterzeichnen."
>
  <div class="flex min-h-screen flex-col bg-white">
    <Header />

    <main id="main-content" class="flex-1">
      <!-- Hero Section -->
      <section class="relative overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white" aria-labelledby="hero-heading">
        <!-- Decorative elements -->
        <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
          <div class="absolute -top-40 -right-40 w-[500px] h-[500px] bg-sky-500/10 rounded-full blur-3xl"></div>
          <div class="absolute -bottom-40 -left-40 w-[400px] h-[400px] bg-amber-500/10 rounded-full blur-3xl"></div>
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-emerald-500/5 rounded-full blur-3xl"></div>
          <!-- Grid pattern -->
          <div class="absolute inset-0 opacity-[0.03]" style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E&quot;);"></div>
        </div>

        <div class="relative container mx-auto px-4 py-16 md:py-24 lg:py-32">
          <div class="max-w-4xl">
            <!-- Eyebrow -->
            <p class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-sm border border-white/10 text-sky-400 font-medium mb-6 text-sm">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
              </svg>
              Gemeinsam für den Frieden
            </p>

            <h1 id="hero-heading" class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 text-balance leading-tight">
              Werden Sie Teil<br class="hidden sm:block" />
              <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-400 to-emerald-400">der Bewegung</span>
            </h1>

            <p class="text-xl md:text-2xl text-slate-300 leading-relaxed max-w-2xl mb-10">
              Die Kampagne Stopp Air Base Ramstein lebt vom Engagement vieler Menschen.
              <strong class="text-white">Jeder Beitrag zählt</strong> — ob durch Ihre Unterschrift, eine Spende oder aktive Mitarbeit.
            </p>

            <!-- Impact stats -->
            <div class="flex flex-wrap gap-6 md:gap-10">
              <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-amber-500/20 flex items-center justify-center">
                  <svg class="w-7 h-7 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                  </svg>
                </div>
                <div>
                  <p class="text-3xl md:text-4xl font-bold text-white">24.978</p>
                  <p class="text-sm text-slate-400">Unterschriften</p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-emerald-500/20 flex items-center justify-center">
                  <svg class="w-7 h-7 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                </div>
                <div>
                  <p class="text-3xl md:text-4xl font-bold text-white">500+</p>
                  <p class="text-sm text-slate-400">Aktive Unterstützer</p>
                </div>
              </div>
              <div class="flex items-center gap-4">
                <div class="w-14 h-14 rounded-2xl bg-sky-500/20 flex items-center justify-center">
                  <svg class="w-7 h-7 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <div>
                  <p class="text-3xl md:text-4xl font-bold text-white">10+</p>
                  <p class="text-sm text-slate-400">Jahre Engagement</p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Wave divider -->
        <div class="absolute bottom-0 left-0 right-0" aria-hidden="true">
          <svg class="w-full h-12 md:h-16 text-white" viewBox="0 0 1440 48" fill="currentColor" preserveAspectRatio="none">
            <path d="M0,48 L1440,48 L1440,0 C1200,32 960,48 720,48 C480,48 240,32 0,0 L0,48 Z"></path>
          </svg>
        </div>
      </section>

      <!-- Engagement Options -->
      <section class="py-16 md:py-24 bg-white" aria-labelledby="engagement-heading">
        <div class="container mx-auto px-4">
          <div class="text-center mb-12 md:mb-16">
            <h2 id="engagement-heading" class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
              So können Sie helfen
            </h2>
            <p class="text-lg text-slate-600 max-w-2xl mx-auto">
              Wählen Sie die Art der Unterstützung, die am besten zu Ihnen passt.
              Jede Form des Engagements bringt uns unserem Ziel näher.
            </p>
          </div>

          <div class="grid gap-6 md:gap-8 md:grid-cols-2 max-w-5xl mx-auto">
            {sortedEntries.map((entry: CollectionEntry<'mitmachen'>, index: number) => (
                <a
                  href={`/mitmachen/${entry.id}/`}
                  class={`group relative flex flex-col rounded-2xl border-2 bg-white overflow-hidden transition-all duration-300 hover:shadow-2xl hover:shadow-slate-200/60 hover:-translate-y-1 no-underline focus:outline-none focus:ring-4 focus:ring-sky-500/20 ${ctaConfig[entry.data.ctaType].borderColor} hover:border-slate-300`}
                >
                  <!-- Image with gradient overlay -->
                  <div class="relative aspect-[16/10] overflow-hidden">
                    <img
                      src={ctaImages[entry.data.ctaType] || '/images/slide2.jpg'}
                      alt=""
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                      aria-hidden="true"
                      loading={index < 2 ? "eager" : "lazy"}
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>

                    <!-- Badge -->
                    <div class={`absolute top-4 left-4 px-3 py-1.5 rounded-full text-sm font-semibold ${ctaConfig[entry.data.ctaType].bgColor} ${ctaConfig[entry.data.ctaType].color} ${ctaConfig[entry.data.ctaType].borderColor} border`}>
                      {ctaConfig[entry.data.ctaType].badge}
                    </div>

                    <!-- Icon overlay on hover -->
                    <div class="absolute bottom-4 right-4 w-12 h-12 rounded-full bg-white/90 backdrop-blur-sm flex items-center justify-center opacity-0 translate-y-2 transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0">
                      <svg class={`w-6 h-6 ${ctaConfig[entry.data.ctaType].color}`} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[ctaConfig[entry.data.ctaType].icon]} />
                    </div>
                  </div>

                  <!-- Content -->
                  <div class="flex flex-col flex-1 p-6">
                    <h3 class="text-xl md:text-2xl font-bold text-slate-900 mb-3 group-hover:text-sky-600 transition-colors">
                      {entry.data.title}
                    </h3>
                    <p class="text-slate-600 mb-6 flex-1 leading-relaxed">
                      {entry.data.description}
                    </p>

                    <!-- CTA row -->
                    <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                      <span class={`font-semibold ${ctaConfig[entry.data.ctaType].color} flex items-center gap-2`}>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" set:html={icons[ctaConfig[entry.data.ctaType].icon]} />
                        {ctaConfig[entry.data.ctaType].label}
                      </span>
                      <span class={`w-10 h-10 rounded-full ${ctaConfig[entry.data.ctaType].bgColor} ${ctaConfig[entry.data.ctaType].hoverBg} flex items-center justify-center transition-colors`}>
                        <svg class={`w-5 h-5 ${ctaConfig[entry.data.ctaType].color} transition-transform duration-300 group-hover:translate-x-1`} fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                        </svg>
                      </span>
                    </div>
                  </div>
                </a>
              ))}
          </div>
        </div>
      </section>

      <!-- Quick Actions Banner -->
      <section class="bg-gradient-to-r from-sky-600 to-sky-700 text-white">
        <div class="container mx-auto px-4 py-10 md:py-12">
          <div class="flex flex-col lg:flex-row items-center justify-between gap-6 text-center lg:text-left">
            <div>
              <h2 class="text-2xl md:text-3xl font-bold mb-2">
                Direkt loslegen?
              </h2>
              <p class="text-sky-100 text-lg">
                Unterzeichnen Sie jetzt den Aufruf oder unterstützen Sie uns mit einer Spende.
              </p>
            </div>
            <div class="flex flex-wrap justify-center gap-4">
              <Button href="mailto:info@stoppramstein.de?subject=Aufruf%20unterzeichnen" variant="secondary" size="lg" external class="!bg-white !text-sky-700 hover:!bg-sky-50">
                <span class="flex items-center gap-2">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                  </svg>
                  Aufruf unterzeichnen
                </span>
              </Button>
              <Button href="/mitmachen/spenden/" variant="ghost" size="lg" class="!text-white !border-white/30 hover:!bg-white/10">
                <span class="flex items-center gap-2">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                  </svg>
                  Spenden
                </span>
              </Button>
            </div>
          </div>
        </div>
      </section>

      <!-- Why Engage Section -->
      <section class="py-16 md:py-24 bg-slate-50" aria-labelledby="why-engage-heading">
        <div class="container mx-auto px-4">
          <div class="max-w-5xl mx-auto">
            <div class="text-center mb-12 md:mb-16">
              <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
                Warum Ihr Engagement wichtig ist
              </h2>
              <p class="text-lg text-slate-600 max-w-2xl mx-auto">
                Gemeinsam erreichen wir mehr. Ihre Unterstützung macht den Unterschied.
              </p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
              <!-- Card 1 -->
              <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-100 hover:shadow-lg hover:border-slate-200 transition-all duration-300">
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-amber-100 to-amber-50 flex items-center justify-center mb-6">
                  <svg class="w-8 h-8 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-3">Stimme erheben</h3>
                <p class="text-slate-600 leading-relaxed">
                  Jede Unterschrift zeigt der Politik, dass die Bevölkerung Frieden will. Gemeinsam machen wir unsere Stimme hörbar.
                </p>
              </div>

              <!-- Card 2 -->
              <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-100 hover:shadow-lg hover:border-slate-200 transition-all duration-300">
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-emerald-100 to-emerald-50 flex items-center justify-center mb-6">
                  <svg class="w-8 h-8 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-3">Unabhängig bleiben</h3>
                <p class="text-slate-600 leading-relaxed">
                  Ihre Spende sichert unsere Unabhängigkeit von Staat und Konzernen. Wir finanzieren uns ausschließlich durch Unterstützer.
                </p>
              </div>

              <!-- Card 3 -->
              <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-100 hover:shadow-lg hover:border-slate-200 transition-all duration-300">
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-sky-100 to-sky-50 flex items-center justify-center mb-6">
                  <svg class="w-8 h-8 text-sky-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                  </svg>
                </div>
                <h3 class="text-xl font-bold text-slate-900 mb-3">Gemeinschaft stärken</h3>
                <p class="text-slate-600 leading-relaxed">
                  Werden Sie Teil einer aktiven Bewegung. Bei uns treffen sich Menschen aller Generationen mit einem gemeinsamen Ziel.
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Testimonial / Quote Section -->
      <section class="py-16 md:py-20 bg-white">
        <div class="container mx-auto px-4">
          <div class="max-w-4xl mx-auto text-center">
            <svg class="w-12 h-12 text-slate-300 mx-auto mb-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
            </svg>
            <blockquote class="text-2xl md:text-3xl font-medium text-slate-800 leading-relaxed mb-8">
              „Von deutschem Boden darf nie wieder Krieg ausgehen. Gemeinsam kämpfen wir für eine friedlichere Welt."
            </blockquote>
            <div class="flex items-center justify-center gap-4">
              <div class="w-px h-8 bg-slate-300"></div>
              <p class="text-slate-600 font-medium">Kampagne Stopp Air Base Ramstein</p>
              <div class="w-px h-8 bg-slate-300"></div>
            </div>
          </div>
        </div>
      </section>

      <!-- Contact Section -->
      <section class="bg-slate-900 text-white">
        <div class="container mx-auto px-4 py-12 md:py-16">
          <div class="max-w-3xl mx-auto text-center">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-slate-800 mb-6">
              <svg class="w-8 h-8 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
