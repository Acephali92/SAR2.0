---
/**
 * Warum Ramstein - Hub Page
 * Lists all topics in the warum-ramstein collection
 */

import { getCollection, type CollectionEntry } from 'astro:content';
import PageLayout from '@layouts/PageLayout.astro';

type TopicEntry = CollectionEntry<'warum-ramstein'>;

const allTopics = await getCollection('warum-ramstein');
const sortedTopics = allTopics
  .filter((topic: TopicEntry) => !topic.data.draft)
  .sort((a: TopicEntry, b: TopicEntry) => (a.data.order || 0) - (b.data.order || 0));

// Get topic pages (excluding index)
const topics = sortedTopics.filter((topic: TopicEntry) => topic.slug !== 'index');

// Category config with images
const categoryConfig: Record<string, { label: string; color: string; bgColor: string; image: string }> = {
  drohnenkrieg: {
    label: 'Drohnenkrieg',
    color: 'text-amber-600',
    bgColor: 'bg-amber-50',
    image: '/images/slide3.jpg'
  },
  umwelt: {
    label: 'Umwelt',
    color: 'text-emerald-600',
    bgColor: 'bg-emerald-50',
    image: '/images/slide4.jpg'
  },
  voelkerrecht: {
    label: 'Völkerrecht',
    color: 'text-red-600',
    bgColor: 'bg-red-50',
    image: '/images/slide5.jpg'
  },
  deutschland: {
    label: 'Deutschland',
    color: 'text-sky-600',
    bgColor: 'bg-sky-50',
    image: '/images/slide2.jpg'
  },
};
---

<PageLayout
  title="Warum Stopp Air Base Ramstein?"
  description="Die Air Base Ramstein ist das Nervenzentrum des US-Drohnenkriegs, ein Umweltzerstörer und ein Symbol für Deutschlands Mittäterschaft an Völkerrechtsbrüchen."
>
  <!-- Hero Section with Image -->
  <section class="mb-12 grid gap-8 lg:grid-cols-2 lg:items-center">
    <div>
      <h1 class="mb-6 text-4xl font-bold text-slate-900 text-balance md:text-5xl">
        Warum Stopp Air Base Ramstein?
      </h1>
      <p class="text-xl text-slate-600">
        Die US Air Base Ramstein ist die größte US-amerikanische Militärbasis
        außerhalb der USA. Sie ist das Nervenzentrum des globalen US-Drohnenkriegs
        und macht Deutschland zum Mittäter an völkerrechtswidrigen Tötungen.
      </p>
    </div>
    <div>
      <img
        src="/images/slide2.jpg"
        alt="Protest gegen Air Base Ramstein"
        class="rounded-lg shadow-lg w-full h-auto"
      />
    </div>
  </section>

  <!-- Topic Cards with Images -->
  <section class="grid gap-6 md:grid-cols-2">
    {
      topics.map((topic: TopicEntry) => {
        const config = categoryConfig[topic.data.category] || {
          label: topic.data.category,
          color: 'text-slate-600',
          bgColor: 'bg-slate-50',
          image: '/images/slide1.jpg'
        };
        return (
          <a
            href={`/warum-ramstein/${topic.slug}/`}
            class="group block rounded-lg border border-slate-200 bg-white shadow-sm overflow-hidden transition-all hover:shadow-md hover:border-slate-300 no-underline"
          >
            <div class="aspect-video overflow-hidden">
              <img
                src={config.image}
                alt={topic.data.title}
                class="w-full h-full object-cover transition-transform group-hover:scale-105"
              />
            </div>
            <div class="p-6">
              <span class={`inline-block px-2 py-1 text-xs font-medium uppercase tracking-wider rounded ${config.color} ${config.bgColor}`}>
                {config.label}
              </span>
              <h2 class="mt-3 text-xl font-semibold text-slate-900">
                {topic.data.title}
              </h2>
              <p class="mt-2 text-slate-600">{topic.data.description}</p>
              <span class="mt-4 inline-block text-sky-600 font-medium">Mehr erfahren →</span>
            </div>
          </a>
        );
      })
    }
  </section>

  <!-- Call to Action -->
  <section class="mt-16 rounded-lg border border-amber-200 bg-amber-50 p-8 text-center">
    <h2 class="mb-4 text-2xl font-bold text-slate-900">Unsere Forderung</h2>
    <p class="mx-auto mb-6 max-w-xl text-xl text-slate-700">
      Von deutschem Boden darf nie wieder Krieg ausgehen!
    </p>
    <p class="mx-auto max-w-xl text-slate-600">
      Wir fordern die Schließung der US Air Base Ramstein und ein Ende der
      deutschen Beteiligung an völkerrechtswidrigen Militäroperationen.
    </p>
    <div class="mt-8">
      <a
        href="/mitmachen/aufruf/"
        class="inline-flex items-center gap-2 rounded-md bg-amber-500 px-6 py-3 font-semibold text-white no-underline transition-colors hover:bg-amber-600"
      >
        Aufruf unterzeichnen
      </a>
    </div>
  </section>
</PageLayout>
