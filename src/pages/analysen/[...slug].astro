---
/**
 * Dynamic route for individual Beiträge (Nachrichten/Analysen), Payload-CMS-backed.
 */

import { getCollection, type CollectionEntry } from 'astro:content';
import ArticleLayout from '@layouts/ArticleLayout.astro';

export async function getStaticPaths() {
  const beitraege = await getCollection('beitraege');
  return beitraege.map((entry: CollectionEntry<'beitraege'>) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'beitraege'>;
}

const { entry } = Astro.props;

// Termine, mit denen dieser Beitrag verknüpft ist (M6) - für den "Verknüpfter Termin"-Block.
const allTermine = await getCollection('termine');
const relatedTermine = allTermine
  .filter((t: CollectionEntry<'termine'>) => entry.data.terminSlugs.includes(t.id))
  .map((t: CollectionEntry<'termine'>) => ({ slug: t.id, title: t.data.title }));
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  publishedAt={entry.data.publishedAt}
  updatedAt={entry.data.updatedAt}
  author={entry.data.author ?? undefined}
  tags={entry.data.tags}
  relatedSlugs={entry.data.relatedSlugs}
  sources={entry.data.sources}
  relatedTermine={relatedTermine}
  image={entry.data.image ?? undefined}
>
  <Fragment set:html={entry.rendered?.html} />
</ArticleLayout>
