---
/**
 * Homepage — Stopp Air Base Ramstein
 * Main landing page with campaign introduction and calls to action.
 */

import PageLayout from '@layouts/PageLayout.astro';
---

<PageLayout
  title="Stopp Air Base Ramstein"
  description="Kampagne für die Schließung der US Air Base Ramstein — für Frieden, Völkerrecht und Umweltschutz."
>
  <!-- Hero Section -->
  <section class="mb-16 grid gap-8 lg:grid-cols-2 lg:items-center">
    <div>
      <h1 class="mb-6 text-4xl font-bold text-slate-900 text-balance md:text-5xl">
        Stopp Air Base Ramstein
      </h1>
      <p class="mb-8 text-xl text-slate-600">
        Von deutschem Boden darf nie wieder Krieg ausgehen. Wir fordern die
        Schließung der US Air Base Ramstein und ein Ende der deutschen Beteiligung
        an völkerrechtswidrigen Militäroperationen.
      </p>
      <div class="flex flex-wrap gap-4">
        <a
          href="/mitmachen/aufruf/"
          class="inline-flex items-center gap-2 rounded-md bg-sky-600 px-6 py-3 font-semibold text-white no-underline transition-colors hover:bg-sky-700"
        >
          Aufruf unterzeichnen
        </a>
        <a
          href="/warum-ramstein/"
          class="inline-flex items-center gap-2 rounded-md border border-slate-300 bg-white px-6 py-3 font-semibold text-slate-700 no-underline transition-colors hover:bg-slate-50"
        >
          Mehr erfahren
        </a>
      </div>
    </div>
    <div class="relative">
      <img
        src="/images/slide1.jpg"
        alt="Friedensaktion vor der Air Base Ramstein"
        class="rounded-lg shadow-lg w-full h-auto"
      />
    </div>
  </section>

  <!-- Key Facts Section -->
  <section class="mb-16">
    <h2 class="mb-8 text-2xl font-semibold text-slate-900">Warum Ramstein?</h2>
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <!-- Fact Card: Drone Warfare -->
      <article class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <div class="mb-4 text-amber-500">
          <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
          </svg>
        </div>
        <h3 class="mb-2 text-lg font-semibold text-slate-900">Drohnenkrieg</h3>
        <p class="text-sm text-slate-600">
          Die Air Base Ramstein ist eine zentrale Relaisstation für US-Drohnenangriffe
          in Pakistan, Jemen, Somalia und anderen Ländern. Tausende Zivilisten wurden getötet.
        </p>
        <a
          href="/warum-ramstein/drohnenkrieg/"
          class="mt-4 inline-block text-sm text-sky-600 hover:text-slate-900"
        >
          Mehr erfahren →
        </a>
      </article>

      <!-- Fact Card: Environment -->
      <article class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <div class="mb-4 text-emerald-500">
          <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <h3 class="mb-2 text-lg font-semibold text-slate-900">Umweltverschmutzung</h3>
        <p class="text-sm text-slate-600">
          PFAS-Kontamination des Grundwassers, jährlich hunderte Tonnen Kerosin über der
          Pfalz abgelassen. Das US-Militär ist der größte Umweltverschmutzer der Welt.
        </p>
        <a
          href="/warum-ramstein/umwelt/"
          class="mt-4 inline-block text-sm text-sky-600 hover:text-slate-900"
        >
          Mehr erfahren →
        </a>
      </article>

      <!-- Fact Card: International Law -->
      <article class="rounded-lg border border-slate-200 bg-white p-6 shadow-sm">
        <div class="mb-4 text-red-500">
          <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
          </svg>
        </div>
        <h3 class="mb-2 text-lg font-semibold text-slate-900">Völkerrechtsbruch</h3>
        <p class="text-sm text-slate-600">
          Ramstein ermöglicht völkerrechtswidrige Angriffskriege. Deutschland macht
          sich durch Duldung mitschuldig an Kriegsverbrechen.
        </p>
        <a
          href="/warum-ramstein/voelkerrecht/"
          class="mt-4 inline-block text-sm text-sky-600 hover:text-slate-900"
        >
          Mehr erfahren →
        </a>
      </article>
    </div>
  </section>

  <!-- Next Event Section -->
  <section class="mb-16 rounded-lg border border-amber-200 bg-amber-50 p-8">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="mb-2 text-sm font-semibold uppercase tracking-wider text-amber-600">
          Nächste Aktion
        </p>
        <h2 class="mb-2 text-2xl font-bold text-slate-900">Friedenswoche 2026</h2>
        <p class="text-slate-600">
          20. – 28. Juni 2026 · Ramstein
        </p>
      </div>
      <a
        href="/aktionen/friedenswoche-2026/"
        class="inline-flex items-center gap-2 rounded-md bg-amber-500 px-6 py-3 font-semibold text-white no-underline transition-colors hover:bg-amber-600"
      >
        Mehr erfahren
      </a>
    </div>
  </section>

  <!-- Call to Action Section -->
  <section class="text-center">
    <h2 class="mb-4 text-2xl font-semibold text-slate-900">Unterstütze die Kampagne</h2>
    <p class="mx-auto mb-8 max-w-xl text-slate-600">
      Gemeinsam können wir ein Zeichen setzen. Unterzeichne den Aufruf, werde
      Mitglied oder unterstütze uns mit einer Spende.
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/mitmachen/aufruf/"
        class="rounded-md border border-slate-300 bg-white px-5 py-2 text-sm font-medium text-slate-700 no-underline transition-colors hover:bg-slate-50"
      >
        Aufruf unterzeichnen
      </a>
      <a
        href="/mitmachen/mitglied-werden/"
        class="rounded-md border border-slate-300 bg-white px-5 py-2 text-sm font-medium text-slate-700 no-underline transition-colors hover:bg-slate-50"
      >
        Mitglied werden
      </a>
      <a
        href="/mitmachen/spenden/"
        class="rounded-md bg-emerald-600 px-5 py-2 text-sm font-medium text-white no-underline transition-colors hover:bg-emerald-700"
      >
        Spenden
      </a>
    </div>
  </section>
</PageLayout>
