---
/**
 * Homepage — Stopp Air Base Ramstein
 * FFF-inspired multi-slide hero: each slide is a unique "landing" with its own
 * background, headline, subline, and CTA — funneling visitors into key actions.
 */

import PageLayout from '@layouts/PageLayout.astro';

// Hero slides - each with unique content and background
const heroSlides = [
  {
    id: 'appell',
    image: '/images/slide1.jpg',
    headline: 'Airbase Ramstein schliessen.',
    subline: 'Kein Drohnenkrieg von deutschem Boden.',
    ctaLine: 'Unterzeichne jetzt den Appell.',
    ctaText: 'Jetzt unterzeichnen',
    ctaHref: '/mitmachen/aufruf/',
    ctaColor: 'cyan', // cyan-blue button
  },
  {
    id: 'friedenscamp',
    image: '/images/slide2.jpg',
    headline: 'Komm ins Friedenscamp',
    subline: 'Jedes Jahr friedlicher Widerstand direkt vor der Airbase.',
    ctaLine: 'Vernetz dich, protestiere, werde Teil der Bewegung.',
    ctaText: 'Mehr zum Friedenscamp',
    ctaHref: '/aktionen/friedenswoche-2026/',
    ctaColor: 'red', // red button
  },
  {
    id: 'newsletter',
    image: '/images/slide3.jpg',
    headline: 'Bleib informiert',
    subline: 'Erhalte aktuelle News, Aktionen und Termine.',
    ctaLine: null, // Newsletter has form instead
    ctaText: null,
    ctaHref: null,
    ctaColor: null,
    hasForm: true,
  },
  {
    id: 'spenden',
    image: '/images/slide4.jpg',
    headline: 'Unterstütze uns',
    subline: 'Mit deiner Spende finanzieren wir Aktionen und das Friedenscamp.',
    ctaLine: 'Jeder Beitrag zählt.',
    ctaText: 'Jetzt spenden',
    ctaHref: '/mitmachen/spenden/',
    ctaColor: 'red', // red button
  },
];
---

<PageLayout
  title="Stopp Air Base Ramstein"
  description="Kampagne für die Schließung der US Air Base Ramstein — für Frieden, Völkerrecht und Umweltschutz."
  wide={true}
  heroOverlap={true}
>
  <!-- Multi-Slide Hero Section -->
  <section
    id="hero-carousel"
    class="relative flex min-h-[100svh] w-full items-center justify-center overflow-hidden"
  >
    <!-- Slides Container -->
    <div class="slides-container absolute inset-0">
      {heroSlides.map((slide, index) => (
        <div
          class:list={[
            'hero-slide absolute inset-0 flex items-center justify-center transition-opacity duration-1000 ease-in-out',
            index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0'
          ]}
          data-slide={index}
          data-slide-id={slide.id}
        >
          <!-- Background Image -->
          <img
            src={slide.image}
            alt=""
            class="absolute inset-0 h-full w-full object-cover"
            aria-hidden="true"
            loading={index === 0 ? 'eager' : 'lazy'}
          />

          <!-- Dark overlay gradient -->
          <div
            class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-black/65"
            aria-hidden="true"
          />

          <!-- Slide Content: Centered -->
          <div class="relative z-10 w-full px-4 text-center">
            <div class="mx-auto max-w-4xl">
              <!-- Massive H1 -->
              <h2 class="hero-title mb-6 text-[2.25rem] font-black uppercase leading-[0.9] tracking-tight text-white sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl">
                {slide.headline}
              </h2>

              <!-- Red underline accent -->
              <div class="mx-auto mb-8 h-2 w-36 rounded-full bg-[#dc2626] shadow-[0_0_30px_rgba(220,38,38,0.4)] md:w-48 lg:w-56" aria-hidden="true" />

              <!-- Subline -->
              <p class="mx-auto mb-4 max-w-2xl text-lg text-white/90 md:text-xl lg:text-2xl">
                {slide.subline}
              </p>

              {/* CTA Line + Button (for slides without form) */}
              {!slide.hasForm && (
                <>
                  <p class="mx-auto mb-8 max-w-2xl text-xl font-bold text-white md:text-2xl lg:text-3xl">
                    {slide.ctaLine}
                  </p>
                  <a
                    href={slide.ctaHref}
                    class:list={[
                      'hero-cta inline-flex items-center gap-3 rounded-full px-10 py-5 text-lg font-bold text-white no-underline shadow-2xl transition-all duration-300 hover:scale-110 md:px-12 md:py-6 md:text-xl',
                      slide.ctaColor === 'cyan'
                        ? 'bg-[#0284c7] hover:bg-[#0ea5e9] hover:shadow-[0_20px_50px_-12px_rgba(2,132,199,0.5)]'
                        : 'bg-[#dc2626] hover:bg-[#ef4444] hover:shadow-[0_20px_50px_-12px_rgba(220,38,38,0.5)]'
                    ]}
                  >
                    {slide.ctaText}
                  </a>
                </>
              )}

              {/* Newsletter Form (for slide 3) */}
              {slide.hasForm && (
                <div class="mx-auto mt-8 max-w-md">
                  <form
                    id="newsletter-form"
                    class="flex flex-col gap-3 sm:flex-row sm:gap-2"
                    action="/api/newsletter"
                    method="POST"
                  >
                    <input
                      type="email"
                      name="email"
                      placeholder="Deine E-Mail-Adresse"
                      required
                      class="flex-1 rounded-full border-2 border-white/30 bg-white/10 px-6 py-4 text-base text-white placeholder-white/60 backdrop-blur-sm transition-all focus:border-white focus:bg-white/20 focus:outline-none md:text-lg"
                    />
                    <button
                      type="submit"
                      class="rounded-full bg-[#dc2626] px-8 py-4 text-base font-bold text-white shadow-lg transition-all duration-300 hover:bg-[#ef4444] hover:scale-105 hover:shadow-xl md:text-lg"
                    >
                      Eintragen
                    </button>
                  </form>
                  <p class="mt-4 text-sm text-white/70">
                    Mit der Anmeldung akzeptierst du unsere{' '}
                    <a href="/datenschutz/" class="underline hover:text-white">
                      Datenschutzerklärung
                    </a>.
                  </p>
                </div>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Navigation Arrows -->
    <button
      type="button"
      id="prev-slide"
      class="nav-arrow absolute left-4 top-1/2 z-30 -translate-y-1/2 rounded-full bg-black/30 p-3 text-white/80 backdrop-blur-sm transition-all duration-300 hover:bg-black/50 hover:text-white hover:scale-110 md:left-8 md:p-4"
      aria-label="Vorheriges Slide"
    >
      <svg class="h-6 w-6 md:h-8 md:w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <button
      type="button"
      id="next-slide"
      class="nav-arrow absolute right-4 top-1/2 z-30 -translate-y-1/2 rounded-full bg-black/30 p-3 text-white/80 backdrop-blur-sm transition-all duration-300 hover:bg-black/50 hover:text-white hover:scale-110 md:right-8 md:p-4"
      aria-label="Nächstes Slide"
    >
      <svg class="h-6 w-6 md:h-8 md:w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <!-- Dot Indicators -->
    <div class="absolute bottom-8 left-1/2 z-30 flex -translate-x-1/2 gap-3" role="tablist" aria-label="Slide Navigation">
      {heroSlides.map((slide, index) => (
        <button
          type="button"
          class:list={[
            'slide-dot h-3 w-3 rounded-full transition-all duration-300 hover:scale-125',
            index === 0
              ? 'bg-[#dc2626] w-8 shadow-[0_0_10px_rgba(220,38,38,0.5)]'
              : 'bg-white/50 hover:bg-white/80'
          ]}
          data-dot={index}
          role="tab"
          aria-selected={index === 0 ? 'true' : 'false'}
          aria-label={`Slide ${index + 1}: ${slide.headline}`}
        />
      ))}
    </div>

    <!-- Progress Bar (optional visual timer) -->
    <div class="absolute bottom-0 left-0 z-20 h-1 w-full bg-black/20">
      <div id="progress-bar" class="h-full w-0 bg-[#dc2626] transition-all ease-linear" />
    </div>
  </section>

  <!-- Key Facts Section -->
  <section class="py-20 md:py-28">
    <div class="container mx-auto px-4 md:px-6">
      <h2 class="mb-12 text-center text-3xl font-bold text-slate-900 md:text-4xl">Warum Ramstein?</h2>
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        <!-- Fact Card: Drone Warfare -->
        <article class="group rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
          <div class="mb-5 inline-flex rounded-xl bg-amber-100 p-3 text-amber-600">
            <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" />
            </svg>
          </div>
          <h3 class="mb-3 text-xl font-bold text-slate-900">Drohnenkrieg</h3>
          <p class="mb-4 text-slate-600">
            Die Air Base Ramstein ist eine zentrale Relaisstation für US-Drohnenangriffe
            in Pakistan, Jemen, Somalia und anderen Ländern. Tausende Zivilisten wurden getötet.
          </p>
          <a
            href="/warum-ramstein/drohnenkrieg/"
            class="inline-flex items-center gap-1 font-semibold text-[#dc2626] no-underline transition-colors hover:text-[#b91c1c]"
          >
            Mehr erfahren
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </article>

        <!-- Fact Card: Environment -->
        <article class="group rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
          <div class="mb-5 inline-flex rounded-xl bg-emerald-100 p-3 text-emerald-600">
            <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="mb-3 text-xl font-bold text-slate-900">Umweltverschmutzung</h3>
          <p class="mb-4 text-slate-600">
            PFAS-Kontamination des Grundwassers, jährlich hunderte Tonnen Kerosin über der
            Pfalz abgelassen. Das US-Militär ist der größte Umweltverschmutzer der Welt.
          </p>
          <a
            href="/warum-ramstein/umwelt/"
            class="inline-flex items-center gap-1 font-semibold text-[#dc2626] no-underline transition-colors hover:text-[#b91c1c]"
          >
            Mehr erfahren
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </article>

        <!-- Fact Card: International Law -->
        <article class="group rounded-2xl border border-slate-200 bg-white p-8 shadow-sm transition-all duration-300 hover:shadow-xl hover:-translate-y-1">
          <div class="mb-5 inline-flex rounded-xl bg-red-100 p-3 text-red-600">
            <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
            </svg>
          </div>
          <h3 class="mb-3 text-xl font-bold text-slate-900">Völkerrechtsbruch</h3>
          <p class="mb-4 text-slate-600">
            Ramstein ermöglicht völkerrechtswidrige Angriffskriege. Deutschland macht
            sich durch Duldung mitschuldig an Kriegsverbrechen.
          </p>
          <a
            href="/warum-ramstein/voelkerrecht/"
            class="inline-flex items-center gap-1 font-semibold text-[#dc2626] no-underline transition-colors hover:text-[#b91c1c]"
          >
            Mehr erfahren
            <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </article>
      </div>
    </div>
  </section>

  <!-- Next Event Section -->
  <section class="bg-gradient-to-r from-amber-50 to-orange-50 py-16 md:py-20">
    <div class="container mx-auto px-4 md:px-6">
      <div class="flex flex-col items-center gap-8 text-center md:flex-row md:justify-between md:text-left">
        <div>
          <p class="mb-2 text-sm font-bold uppercase tracking-wider text-amber-600">
            Nächste Aktion
          </p>
          <h2 class="mb-2 text-3xl font-bold text-slate-900 md:text-4xl">Friedenswoche 2026</h2>
          <p class="text-lg text-slate-600">
            20. – 28. Juni 2026 · Ramstein
          </p>
        </div>
        <a
          href="/aktionen/friedenswoche-2026/"
          class="inline-flex items-center gap-2 rounded-full bg-amber-500 px-10 py-4 text-lg font-bold text-white no-underline shadow-lg transition-all duration-300 hover:bg-amber-400 hover:shadow-xl hover:scale-105"
        >
          Mehr erfahren
        </a>
      </div>
    </div>
  </section>

  <!-- Call to Action Section -->
  <section class="py-20 md:py-28">
    <div class="container mx-auto px-4 text-center md:px-6">
      <h2 class="mb-4 text-3xl font-bold text-slate-900 md:text-4xl">Unterstütze die Kampagne</h2>
      <p class="mx-auto mb-10 max-w-xl text-lg text-slate-600">
        Gemeinsam können wir ein Zeichen setzen. Unterzeichne den Aufruf, werde
        Mitglied oder unterstütze uns mit einer Spende.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/mitmachen/aufruf/"
          class="rounded-full border-2 border-slate-300 bg-white px-8 py-3 font-bold text-slate-700 no-underline transition-all duration-200 hover:border-[#0284c7] hover:text-[#0284c7]"
        >
          Aufruf unterzeichnen
        </a>
        <a
          href="/mitmachen/mitglied-werden/"
          class="rounded-full border-2 border-slate-300 bg-white px-8 py-3 font-bold text-slate-700 no-underline transition-all duration-200 hover:border-[#0284c7] hover:text-[#0284c7]"
        >
          Mitglied werden
        </a>
        <a
          href="/mitmachen/spenden/"
          class="rounded-full bg-[#dc2626] px-8 py-3 font-bold text-white no-underline shadow-lg transition-all duration-200 hover:bg-[#ef4444] hover:shadow-xl hover:scale-105"
        >
          Spenden
        </a>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  /* Hero title: strong text shadow */
  .hero-title {
    text-shadow:
      0 2px 4px rgba(0, 0, 0, 0.3),
      0 8px 40px rgba(0, 0, 0, 0.4);
  }

  /* CTA button glow */
  .hero-cta {
    box-shadow:
      0 10px 40px -10px currentColor,
      0 4px 20px -5px rgba(0, 0, 0, 0.2);
  }

  /* Nav arrows fade in on desktop */
  @media (min-width: 768px) {
    .nav-arrow {
      opacity: 0;
    }

    #hero-carousel:hover .nav-arrow {
      opacity: 1;
    }
  }

  /* Active dot indicator style */
  .slide-dot[aria-selected="true"] {
    @apply w-8 bg-[#dc2626] shadow-[0_0_10px_rgba(220,38,38,0.5)];
  }

  .slide-dot[aria-selected="false"] {
    @apply w-3 bg-white/50;
  }
</style>

<script>
  // Multi-slide hero carousel with auto-cycle, manual controls, and hover pause
  const carousel = document.getElementById('hero-carousel');
  const slides = document.querySelectorAll('.hero-slide');
  const dots = document.querySelectorAll('.slide-dot');
  const prevBtn = document.getElementById('prev-slide');
  const nextBtn = document.getElementById('next-slide');
  const progressBar = document.getElementById('progress-bar');

  const totalSlides = slides.length;
  const SLIDE_DURATION = 10000; // 10 seconds per slide

  let currentSlide = 0;
  let isPaused = false;
  let autoplayInterval: ReturnType<typeof setInterval> | null = null;
  let progressStart = 0;

  // Go to specific slide
  function goToSlide(index: number) {
    if (index === currentSlide) return;

    // Update z-index and opacity for smooth transition
    slides.forEach((slide, i) => {
      const el = slide as HTMLElement;
      if (i === index) {
        el.classList.remove('opacity-0', 'z-0');
        el.classList.add('opacity-100', 'z-10');
      } else if (i === currentSlide) {
        el.classList.remove('opacity-100', 'z-10');
        el.classList.add('opacity-0', 'z-0');
      }
    });

    // Update dots
    dots.forEach((dot, i) => {
      dot.setAttribute('aria-selected', i === index ? 'true' : 'false');
    });

    currentSlide = index;
    resetProgress();
  }

  // Next slide
  function nextSlide() {
    goToSlide((currentSlide + 1) % totalSlides);
  }

  // Previous slide
  function prevSlide() {
    goToSlide((currentSlide - 1 + totalSlides) % totalSlides);
  }

  // Reset and start progress bar
  function resetProgress() {
    if (progressBar) {
      progressBar.style.transition = 'none';
      progressBar.style.width = '0%';

      // Force reflow
      progressBar.offsetHeight;

      if (!isPaused) {
        progressBar.style.transition = `width ${SLIDE_DURATION}ms linear`;
        progressBar.style.width = '100%';
      }
    }
    progressStart = Date.now();
  }

  // Start autoplay
  function startAutoplay() {
    stopAutoplay();
    autoplayInterval = setInterval(() => {
      if (!isPaused) {
        nextSlide();
      }
    }, SLIDE_DURATION);
    resetProgress();
  }

  // Stop autoplay
  function stopAutoplay() {
    if (autoplayInterval) {
      clearInterval(autoplayInterval);
      autoplayInterval = null;
    }
  }

  // Pause on hover
  function pauseCarousel() {
    isPaused = true;
    if (progressBar) {
      const elapsed = Date.now() - progressStart;
      const progress = Math.min((elapsed / SLIDE_DURATION) * 100, 100);
      progressBar.style.transition = 'none';
      progressBar.style.width = `${progress}%`;
    }
  }

  // Resume on mouse leave
  function resumeCarousel() {
    isPaused = false;
    if (progressBar) {
      const elapsed = Date.now() - progressStart;
      const remaining = SLIDE_DURATION - elapsed;
      if (remaining > 0) {
        progressBar.style.transition = `width ${remaining}ms linear`;
        progressBar.style.width = '100%';
      }
    }
  }

  // Initialize
  if (totalSlides > 1) {
    // Event listeners for arrows
    prevBtn?.addEventListener('click', () => {
      prevSlide();
      startAutoplay(); // Reset timer on manual navigation
    });

    nextBtn?.addEventListener('click', () => {
      nextSlide();
      startAutoplay();
    });

    // Event listeners for dots
    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        goToSlide(index);
        startAutoplay();
      });
    });

    // Hover pause
    carousel?.addEventListener('mouseenter', pauseCarousel);
    carousel?.addEventListener('mouseleave', resumeCarousel);

    // Touch pause (for mobile)
    carousel?.addEventListener('touchstart', pauseCarousel, { passive: true });
    carousel?.addEventListener('touchend', resumeCarousel);

    // Keyboard navigation
    carousel?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        prevSlide();
        startAutoplay();
      } else if (e.key === 'ArrowRight') {
        nextSlide();
        startAutoplay();
      }
    });

    // Start autoplay
    startAutoplay();
  }

  // Newsletter form handling (prevent page reload)
  const newsletterForm = document.getElementById('newsletter-form');
  newsletterForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const _email = new FormData(form).get('email'); // TODO: Use for actual API call

    // Show loading state
    const submitBtn = form.querySelector('button[type="submit"]');
    if (submitBtn) {
      submitBtn.textContent = 'Wird gesendet...';
      (submitBtn as HTMLButtonElement).disabled = true;
    }

    try {
      // Simulate API call (replace with actual endpoint)
      await new Promise(resolve => setTimeout(resolve, 1000));

      // Success feedback
      if (submitBtn) {
        submitBtn.textContent = 'Eingetragen!';
        submitBtn.classList.remove('bg-[#dc2626]', 'hover:bg-[#ef4444]');
        submitBtn.classList.add('bg-emerald-500');
      }
      form.reset();

      // Reset button after delay
      setTimeout(() => {
        if (submitBtn) {
          submitBtn.textContent = 'Eintragen';
          (submitBtn as HTMLButtonElement).disabled = false;
          submitBtn.classList.add('bg-[#dc2626]', 'hover:bg-[#ef4444]');
          submitBtn.classList.remove('bg-emerald-500');
        }
      }, 3000);
    } catch (error) {
      if (submitBtn) {
        submitBtn.textContent = 'Fehler - Erneut versuchen';
        (submitBtn as HTMLButtonElement).disabled = false;
      }
    }
  });
</script>
