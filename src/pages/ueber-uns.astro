---
/**
 * Über uns Page
 *
 * Informational page about the Stopp Air Base Ramstein campaign.
 * Structured for trust, readability, and accessibility.
 */

import PageLayout from '@layouts/PageLayout.astro';

// Advisory board members data
const advisoryBoard = [
  { name: 'Julieta Daza', country: 'Venezuela' },
  { name: 'Pat Elder', country: 'USA' },
  { name: 'Leo Gabriel', country: 'Österreich' },
  { name: 'Joseph Gerson', country: 'USA' },
  { name: 'Ross Gwyther', country: 'Australien' },
  { name: 'Piotr Ikonowicz', country: 'Polen' },
  { name: 'John Lannon', country: 'Irland' },
  { name: 'Alain Rouy', country: 'Frankreich' },
  { name: 'Ikuko Ueno', country: 'Japan' },
  { name: 'Dave Webb', country: 'England' },
  { name: 'Ann Wright', country: 'USA' },
  { name: 'Michael Youlton', country: 'Irland' },
];

// Core principles
const principles = [
  {
    title: 'Pazifismus',
    description: 'Gewaltfreiheit als Grundlage unseres Handelns',
  },
  {
    title: 'Internationale Solidarität',
    description: 'Verbundenheit mit Friedensbewegungen weltweit',
  },
  {
    title: 'Antimilitarismus',
    description: 'Ablehnung von Krieg als Mittel der Politik',
  },
  {
    title: 'Antifaschismus',
    description: 'Widerstand gegen autoritäre und menschenfeindliche Ideologien',
  },
];

// Key activities
const activities = [
  {
    title: 'Jährliche Friedenswoche',
    description: 'Camp, Workshops und Demonstration vor der Air Base',
  },
  {
    title: 'Öffentlichkeitsarbeit',
    description: 'Politische Aufklärung und Medienarbeit',
  },
  {
    title: 'Vernetzung',
    description: 'Zusammenarbeit mit Friedensgruppen national und international',
  },
  {
    title: 'Dokumentation',
    description: 'Erfassung von Völkerrechtsbrüchen und Umweltschäden',
  },
];
---

<PageLayout
  title="Über uns"
  description="Die Kampagne Stopp Air Base Ramstein – wer wir sind, was wir wollen und wie wir arbeiten."
>
  <article class="max-w-prose mx-auto">
    <!-- Page Header -->
    <header class="mb-12">
      <h1 class="text-3xl md:text-4xl font-semibold text-slate-900 mb-4 text-balance">
        Über uns
      </h1>
      <p class="text-lg text-slate-600 leading-relaxed">
        Die Kampagne <strong>Stopp Air Base Ramstein</strong> setzt sich seit 2015 für Frieden,
        Abrüstung und die Schließung der US-Militärbasis ein. Wir sind Teil der deutschen und
        internationalen Friedensbewegung.
      </p>
    </header>

    <!-- Trust indicators -->
    <aside class="flex flex-wrap gap-4 mb-12 text-sm text-slate-500" aria-label="Eckdaten">
      <span class="inline-flex items-center gap-1.5">
        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span>Aktiv seit 2015</span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
        <span>Berlin</span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>International vernetzt</span>
      </span>
    </aside>

    <!-- Who we are -->
    <section class="mb-12" aria-labelledby="wer-wir-sind">
      <h2 id="wer-wir-sind" class="text-2xl font-semibold text-slate-900 mb-4">
        Wer wir sind
      </h2>
      <div class="space-y-4 text-slate-700 leading-relaxed">
        <p>
          Viele von uns sind bereits langjährig in der Friedensbewegung tätig. Immer mehr
          Aktive in unseren Reihen haben sich aber erst in den letzten Jahren politisiert
          und sind als Neulinge zu uns gestoßen.
        </p>
        <p>
          Damit sind wir altersmäßig sehr gemischt, aber als junge Bewegung zugleich in
          der Tradition der Friedensbewegung verwurzelt.
        </p>
      </div>
    </section>

    <!-- Our principles -->
    <section class="mb-12" aria-labelledby="grundprinzipien">
      <h2 id="grundprinzipien" class="text-2xl font-semibold text-slate-900 mb-6">
        Unsere Grundprinzipien
      </h2>
      <ul class="grid gap-4 sm:grid-cols-2" role="list">
        {principles.map((principle) => (
          <li class="p-4 rounded-lg bg-slate-50 border border-slate-100">
            <h3 class="font-semibold text-slate-900 mb-1">{principle.title}</h3>
            <p class="text-sm text-slate-600">{principle.description}</p>
          </li>
        ))}
      </ul>
    </section>

    <!-- How we work -->
    <section class="mb-12" aria-labelledby="wie-wir-arbeiten">
      <h2 id="wie-wir-arbeiten" class="text-2xl font-semibold text-slate-900 mb-4">
        Wie wir arbeiten
      </h2>
      <p class="text-slate-700 leading-relaxed mb-6">
        Unsere Aktivitäten planen wir mit einem größeren Orga-Team, in dem wir in
        familiärer Atmosphäre kreative Ideen entwickeln. Wir arbeiten basisdemokratisch
        und transparent.
      </p>

      <h3 class="text-lg font-semibold text-slate-800 mb-4">Unsere Hauptaktivitäten</h3>
      <ul class="space-y-3" role="list">
        {activities.map((activity) => (
          <li class="flex gap-3 items-start">
            <svg class="w-5 h-5 text-sky-600 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <div>
              <span class="font-medium text-slate-900">{activity.title}</span>
              <span class="text-slate-600"> – {activity.description}</span>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Our demands -->
    <section class="mb-12" aria-labelledby="forderungen">
      <h2 id="forderungen" class="text-2xl font-semibold text-slate-900 mb-4">
        Unsere Forderungen
      </h2>

      <div class="p-5 rounded-lg bg-amber-50 border border-amber-100 mb-6">
        <h3 class="text-sm font-semibold text-amber-900 uppercase tracking-wide mb-3">
          Fakten zur Air Base Ramstein
        </h3>
        <ul class="space-y-2 text-sm text-amber-800">
          <li class="flex gap-2 items-start">
            <span class="text-amber-600" aria-hidden="true">•</span>
            <span>Größter US-Militärstützpunkt außerhalb der USA</span>
          </li>
          <li class="flex gap-2 items-start">
            <span class="text-amber-600" aria-hidden="true">•</span>
            <span>Steuerungszentrum für völkerrechtswidrige Drohneneinsätze</span>
          </li>
          <li class="flex gap-2 items-start">
            <span class="text-amber-600" aria-hidden="true">•</span>
            <span>Zentrale Drehscheibe für NATO-Kriegslogistik</span>
          </li>
          <li class="flex gap-2 items-start">
            <span class="text-amber-600" aria-hidden="true">•</span>
            <span>Massive Umweltbelastung durch PFAS und Kerosin</span>
          </li>
        </ul>
      </div>

      <ul class="space-y-2 text-slate-700">
        <li class="flex gap-2 items-start">
          <svg class="w-5 h-5 text-slate-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
          <span>Sofortige Schließung der Air Base Ramstein</span>
        </li>
        <li class="flex gap-2 items-start">
          <svg class="w-5 h-5 text-slate-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
          <span>Stopp der militärischen Aufrüstung</span>
        </li>
        <li class="flex gap-2 items-start">
          <svg class="w-5 h-5 text-slate-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
          <span>Umwidmung militärischer Infrastruktur für zivile Zwecke</span>
        </li>
        <li class="flex gap-2 items-start">
          <svg class="w-5 h-5 text-slate-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
          <span>Deutsche Souveränität über deutsches Territorium</span>
        </li>
      </ul>
    </section>

    <hr class="border-slate-200 my-12" />

    <!-- International Advisory Board -->
    <section class="mb-12" aria-labelledby="beirat">
      <h2 id="beirat" class="text-2xl font-semibold text-slate-900 mb-4">
        Internationaler Beirat
      </h2>
      <p class="text-slate-700 leading-relaxed mb-6">
        Der internationale Beirat berät die Kampagne Stopp Air Base Ramstein und
        verbindet uns mit der weltweiten Friedensbewegung.
      </p>

      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {advisoryBoard.map((member) => (
          <div class="flex items-center gap-3 p-3 rounded-lg bg-slate-50 border border-slate-100">
            <div class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-200 text-sm font-medium text-slate-600 shrink-0">
              {member.name.split(' ').map((n) => n[0]).join('').slice(0, 2)}
            </div>
            <div class="min-w-0">
              <p class="font-medium text-slate-900 truncate">{member.name}</p>
              <p class="text-sm text-slate-500">{member.country}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <hr class="border-slate-200 my-12" />

    <!-- Contact -->
    <section aria-labelledby="kontakt">
      <h2 id="kontakt" class="text-2xl font-semibold text-slate-900 mb-4">
        Kontakt
      </h2>

      <address class="not-italic space-y-4 text-slate-700">
        <div>
          <p class="font-semibold text-slate-900">Aktionsbüro</p>
          <p>Stopp Air Base Ramstein Kampagne</p>
          <p>Marienstr. 19/20</p>
          <p>10117 Berlin</p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="mailto:info@stoppramstein.de"
            class="inline-flex items-center gap-2 text-sky-700 hover:text-sky-900 no-underline hover:underline"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            info@stoppramstein.de
          </a>
          <a
            href="tel:+4915226603872"
            class="inline-flex items-center gap-2 text-sky-700 hover:text-sky-900 no-underline hover:underline"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            0152 / 266 038 72
          </a>
        </div>
      </address>

      <div class="mt-6">
        <a
          href="/kontakt/"
          class="inline-flex items-center gap-1 text-sky-700 font-medium hover:text-sky-900"
        >
          Zur Kontaktseite
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </section>
  </article>
</PageLayout>
