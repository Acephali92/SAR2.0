{
  "name": "stopp-air-base-ramstein",
  "type": "module",
  "version": "1.0.0",
  "description": "Official website for the Stopp Air Base Ramstein peace initiative",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "postbuild": "pagefind --site dist",
    "typecheck": "astro check",
    "check-links": "node scripts/check-links.mjs",
    "check-csp": "node scripts/check-csp.mjs",
    "verify": "npm run typecheck && npm run build && npm run check-links && npm run check-csp"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/typography": "0.5.20",
    "astro": "7.3.8",
    "autoprefixer": "10.6.1",
    "tailwindcss": "3.4.17",
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "pagefind": "1.5.2",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
